+LIB_TREE_NODE_GROUP::LIB_TREE_NODE_GROUP( LIB_TREE_NODE* aParent, const wxString& aGroupName )
+{
+    m_Type = TYPE::GROUP;
+    m_Parent = aParent;
+    m_Name = aGroupName;
