+void SCH_SYMBOL_LIBRARY_PANE::onPreviewPaneChanged( wxCommandEvent& aEvent )
+{
+    Freeze();
+    adjustPreviewPaneSashes();
+    Layout();
+    Thaw();
+
+    aEvent.Skip();
+}
+
+
+void SCH_SYMBOL_LIBRARY_PANE::onDetailsPreviewSashChanged( wxSplitterEvent& aEvent )
+{
+    if( m_detailsPane && m_previewPane && m_detailsPane->IsExpanded()
+            && m_previewPane->IsExpanded() )
+    {
+        m_detailsPreviewSash = aEvent.GetSashPosition();
+    }
+
+    aEvent.Skip();
+}
+
+
+void SCH_SYMBOL_LIBRARY_PANE::adjustPreviewPaneSashes()
+{
+    if( !m_detailsPreviewSplitter || !m_detailsPane || !m_previewPane
+            || !m_detailsPreviewSplitter->IsSplit() )
+    {
+        return;
+    }
+
+    int splitterHeight = m_detailsPreviewSplitter->GetClientSize().y;
+
+    if( splitterHeight <= 0 )
+        return;
+
+    int minHeaderHeight = FromDIP( 28 );
+    int detailsHeaderHeight = std::max( minHeaderHeight, m_detailsPane->GetBestSize().y );
+    int previewHeaderHeight = std::max( minHeaderHeight, m_previewPane->GetBestSize().y );
+
+    if( m_detailsPane->IsCollapsed() && !m_previewPane->IsCollapsed() )
+    {
+        m_detailsPreviewSplitter->SetSashPosition( detailsHeaderHeight );
+    }
+    else if( !m_detailsPane->IsCollapsed() && m_previewPane->IsCollapsed() )
+    {
+        m_detailsPreviewSplitter->SetSashPosition(
+                std::max( minHeaderHeight, splitterHeight - previewHeaderHeight ) );
+    }
+    else if( m_detailsPane->IsExpanded() && m_previewPane->IsExpanded()
+             && m_detailsPreviewSash > 0 )
+    {
+        m_detailsPreviewSplitter->SetSashPosition( m_detailsPreviewSash );
+    }
+
+    m_detailsPreviewSplitter->Layout();
+}
