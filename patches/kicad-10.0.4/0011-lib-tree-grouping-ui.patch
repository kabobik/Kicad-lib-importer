+void LIB_TREE::updateGroupingControls()
+{
+    if( !m_groupingPanel || !m_groupingSizer )
+        return;
+
+    m_groupingSizer->Clear( true );
+
+    const std::vector<wxString>& groupColumns = m_adapter->GetGroupColumns();
+
+    if( groupColumns.empty() )
+    {
+        m_groupingPanel->Hide();
+        Layout();
+        return;
+    }
+
+    wxStaticText* label = new wxStaticText( m_groupingPanel, wxID_ANY, _( "Grouped by:" ) );
+    m_groupingSizer->Add( label, 0, wxALIGN_CENTER_VERTICAL | wxRIGHT | wxBOTTOM, FromDIP( 4 ) );
+
+    for( const wxString& column : groupColumns )
+    {
+        wxString displayName = wxGetTranslation( column );
+        wxString buttonLabel = wxString::Format( wxT( "%s  x" ), displayName );
+
+        wxButton* button = new wxButton( m_groupingPanel, wxID_ANY, buttonLabel,
+                                         wxDefaultPosition, wxDefaultSize, wxBU_EXACTFIT );
+        button->SetToolTip( wxString::Format( _( "Remove '%s' from grouping" ), displayName ) );
+        button->Bind( wxEVT_BUTTON,
+                [this, column]( wxCommandEvent& )
+                {
+                    removeGroupingColumn( column );
+                } );
+
+        m_groupingSizer->Add( button, 0, wxALIGN_CENTER_VERTICAL | wxRIGHT | wxBOTTOM,
+                              FromDIP( 4 ) );
+    }
+
+    m_groupingPanel->Show();
+    m_groupingPanel->Layout();
+    Layout();
+}
+
+
+void LIB_TREE::removeGroupingColumn( const wxString& aColumn )
+{
+    m_adapter->RemoveGroupColumn( aColumn );
+    updateGroupingControls();
+}
