+void KIGFX::DS_PAINTER::DrawPageBackground( const PAGE_INFO* aPageInfo, int aScaleFactor ) const
+{
+    if( m_renderSettings.m_pageBackgroundColor.a <= 0.0 )
+        return;
+
+    const double pageLeft = 0.0;
+    const double pageTop = 0.0;
+    const double pageRight = aPageInfo->GetWidthMils() * aScaleFactor;
+    const double pageBottom = aPageInfo->GetHeightMils() * aScaleFactor;
+
+    m_gal->SetIsStroke( false );
+    m_gal->SetIsFill( true );
+    m_gal->SetFillColor( m_renderSettings.m_pageBackgroundColor );
+    m_gal->DrawRectangle( VECTOR2D( pageLeft, pageTop ), VECTOR2D( pageRight, pageBottom ) );
+}
