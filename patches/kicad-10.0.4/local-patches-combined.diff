+void KIGFX::DS_PAINTER::DrawPageBackground( const PAGE_INFO* aPageInfo, int aScaleFactor,
+                                            const BOX2I& aViewport ) const
+{
+    m_gal->SetIsStroke( false );
+    m_gal->SetIsFill( true );
+
+    auto drawRect =
+            [&]( double aLeft, double aTop, double aRight, double aBottom, const COLOR4D& aColor )
+            {
+                if( aColor.a <= 0.0 || aRight <= aLeft || aBottom <= aTop )
+                    return;
+
+                m_gal->SetFillColor( aColor );
+                m_gal->DrawRectangle( VECTOR2D( aLeft, aTop ), VECTOR2D( aRight, aBottom ) );
+            };
+
+    const double pageLeft = 0.0;
+    const double pageTop = 0.0;
+    const double pageRight = aPageInfo->GetWidthMils() * aScaleFactor;
+    const double pageBottom = aPageInfo->GetHeightMils() * aScaleFactor;
+
+    const double viewLeft = std::min( aViewport.GetLeft(), aViewport.GetRight() );
+    const double viewRight = std::max( aViewport.GetLeft(), aViewport.GetRight() );
+    const double viewTop = std::min( aViewport.GetTop(), aViewport.GetBottom() );
+    const double viewBottom = std::max( aViewport.GetTop(), aViewport.GetBottom() );
+
+    drawRect( viewLeft, viewTop, viewRight, std::min( viewBottom, pageTop ),
+              m_renderSettings.m_backgroundColor );
+    drawRect( viewLeft, std::max( viewTop, pageBottom ), viewRight, viewBottom,
+              m_renderSettings.m_backgroundColor );
+
+    const double sideTop = std::max( viewTop, pageTop );
+    const double sideBottom = std::min( viewBottom, pageBottom );
+
+    drawRect( viewLeft, sideTop, std::min( viewRight, pageLeft ), sideBottom,
+              m_renderSettings.m_backgroundColor );
+    drawRect( std::max( viewLeft, pageRight ), sideTop, viewRight, sideBottom,
+              m_renderSettings.m_backgroundColor );
+
+    drawRect( pageLeft, pageTop, pageRight, pageBottom, m_renderSettings.m_pageBackgroundColor );
+}
