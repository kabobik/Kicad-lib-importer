+void SCH_EDIT_FRAME::ToggleSymbolLibraryPanel()
+{
+    EESCHEMA_SETTINGS* cfg = eeconfig();
+
+    wxCHECK( cfg, /* void */ );
+
+    wxAuiPaneInfo& symbolLibraryPane = m_auimgr.GetPane( SymbolLibraryPaneName() );
+
+    symbolLibraryPane.Show( !symbolLibraryPane.IsShown() );
+
+    if( symbolLibraryPane.IsShown() )
+    {
+        if( symbolLibraryPane.IsFloating() )
+        {
+            symbolLibraryPane.FloatingSize( cfg->m_AuiPanels.symbol_library_panel_float_width,
+                                            cfg->m_AuiPanels.symbol_library_panel_float_height );
+            m_auimgr.Update();
+        }
+        else if( cfg->m_AuiPanels.symbol_library_panel_docked_width > 0 )
+        {
+            SetAuiPaneSize( m_auimgr, symbolLibraryPane,
+                            cfg->m_AuiPanels.symbol_library_panel_docked_width, -1 );
+        }
+        else
+        {
+            m_auimgr.Update();
+        }
+    }
+    else
+    {
+        if( symbolLibraryPane.IsFloating() )
+        {
+            cfg->m_AuiPanels.symbol_library_panel_float_width = symbolLibraryPane.floating_size.x;
+            cfg->m_AuiPanels.symbol_library_panel_float_height = symbolLibraryPane.floating_size.y;
+        }
+        else if( m_symbolLibraryPane )
+        {
+            cfg->m_AuiPanels.symbol_library_panel_docked_width = m_symbolLibraryPane->GetSize().x;
+        }
+
+        m_auimgr.Update();
     }
 }
 
