+
+SCH_SYMBOL_LIBRARY_PANE::SCH_SYMBOL_LIBRARY_PANE( SCH_EDIT_FRAME* aFrame ) :
+        wxPanel( aFrame, wxID_ANY, wxDefaultPosition, wxDefaultSize ),
+        m_frame( aFrame ),
+        m_tree( nullptr ),
+        m_details( nullptr ),
+        m_symbolPreview( nullptr ),
+        m_fpSelect( nullptr ),
+        m_fpPreview( nullptr ),
+        m_openLibsTimer( nullptr )
+{
+    SYMBOL_LIBRARY_ADAPTER* libmgr = PROJECT_SCH::SymbolLibAdapter( &m_frame->Prj() );
+
+    // Ensure settings are loaded before background symbol loading starts.
+    GetAppSettings<EESCHEMA_SETTINGS>( "eeschema" );
+    GetAppSettings<SYMBOL_EDITOR_SETTINGS>( "symbol_editor" );
+
+    m_adapter = SYMBOL_TREE_MODEL_ADAPTER::Create( m_frame, libmgr );
+    SYMBOL_TREE_MODEL_ADAPTER* adapter = static_cast<SYMBOL_TREE_MODEL_ADAPTER*>( m_adapter.get() );
+
+    adapter->AddLibraries( m_frame );
+
+    wxBoxSizer* sizer = new wxBoxSizer( wxVERTICAL );
+
+    m_details = new HTML_WINDOW( this, wxID_ANY, wxDefaultPosition, wxDefaultSize );
+    m_tree = new LIB_TREE( this, wxT( "symbols" ), m_adapter,
+                           LIB_TREE::SEARCH | LIB_TREE::DETAILS | LIB_TREE::NO_HOVER_PREVIEW,
+                           m_details );
+
+    EDA_DRAW_PANEL_GAL::GAL_TYPE backend = EDA_DRAW_PANEL_GAL::GAL_TYPE::GAL_TYPE_OPENGL;
+
+    if( m_frame->GetCanvas() )
+        backend = m_frame->GetCanvas()->GetBackend();
+    else if( COMMON_SETTINGS* cfg = Pgm().GetCommonSettings() )
+        backend = static_cast<EDA_DRAW_PANEL_GAL::GAL_TYPE>( cfg->m_Graphics.canvas_type );
+
+    m_symbolPreview = new SYMBOL_PREVIEW_WIDGET( this, &m_frame->Kiway(), true, backend );
+    m_symbolPreview->SetLayoutDirection( wxLayout_LeftToRight );
+
+    m_fpSelect = new FOOTPRINT_SELECT_WIDGET( m_frame, this );
+
+    m_fpPreview = new FOOTPRINT_PREVIEW_WIDGET( this, m_frame->Kiway() );
+    m_fpPreview->SetUserUnits( m_frame->GetUserUnits() );
+
+    if( m_fpPreview->IsInitialized() )
+        m_fpPreview->SetStatusText( wxEmptyString );
+
+    m_details->SetMinSize( wxSize( -1, FromDIP( 88 ) ) );
+    m_symbolPreview->SetMinSize( wxSize( -1, FromDIP( 140 ) ) );
+    m_fpPreview->SetMinSize( wxSize( -1, FromDIP( 140 ) ) );
+
+    sizer->Add( m_tree, 4, wxEXPAND | wxALL, 4 );
+    sizer->Add( m_details, 2, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, 4 );
+    sizer->Add( m_symbolPreview, 3, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, 4 );
+    sizer->Add( m_fpSelect, 0, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, 4 );
+    sizer->Add( m_fpPreview, 3, wxEXPAND | wxLEFT | wxRIGHT | wxBOTTOM, 4 );
+
+    SetSizer( sizer );
+    Layout();
+
+    adapter->FinishTreeInitialization();
+
+    if( !s_symbolLibraryPaneSearchString.IsEmpty() )
+        m_tree->SetSearchString( s_symbolLibraryPaneSearchString );
+
+    m_fpSelect->Load( m_frame->Kiway(), m_frame->Prj() );
+    populateFootprintSelector( LIB_ID() );
+
+    m_adapter->RegisterLazyLoadHandler( [this]()
+                                        {
+                                            Regenerate();
+                                        } );
+
+    Bind( EVT_LIBITEM_SELECTED, &SCH_SYMBOL_LIBRARY_PANE::onSymbolSelected, this );
+    Bind( EVT_LIBITEM_CHOSEN, &SCH_SYMBOL_LIBRARY_PANE::onSymbolChosen, this );
+    m_fpSelect->Bind( EVT_FOOTPRINT_SELECTED, &SCH_SYMBOL_LIBRARY_PANE::onFootprintSelected, this );
+
+    m_openLibsTimer = new wxTimer( this );
+    Bind( wxEVT_TIMER, &SCH_SYMBOL_LIBRARY_PANE::onOpenLibsTimer, this, m_openLibsTimer->GetId() );
+    m_openLibsTimer->StartOnce( 300 );
+}
+
+
+SCH_SYMBOL_LIBRARY_PANE::~SCH_SYMBOL_LIBRARY_PANE()
+{
+    s_symbolLibraryPaneSearchString = m_tree->GetSearchString();
+
+    Unbind( EVT_LIBITEM_SELECTED, &SCH_SYMBOL_LIBRARY_PANE::onSymbolSelected, this );
+    Unbind( EVT_LIBITEM_CHOSEN, &SCH_SYMBOL_LIBRARY_PANE::onSymbolChosen, this );
+
+    if( m_fpSelect )
+        m_fpSelect->Unbind( EVT_FOOTPRINT_SELECTED, &SCH_SYMBOL_LIBRARY_PANE::onFootprintSelected, this );
+
+    if( m_openLibsTimer )
+    {
+        m_openLibsTimer->Stop();
+        Unbind( wxEVT_TIMER, &SCH_SYMBOL_LIBRARY_PANE::onOpenLibsTimer, this,
+                m_openLibsTimer->GetId() );
+        delete m_openLibsTimer;
+    }
+
+    if( m_adapter )
+        m_adapter->SaveSettings();
+}
+
+
+void SCH_SYMBOL_LIBRARY_PANE::Regenerate()
+{
+    LIB_ID savedSelection = m_tree->GetSelectedLibId();
+    m_tree->Regenerate( true );
+
+    if( savedSelection.IsValid() )
+        m_tree->CenterLibId( savedSelection );
+}
+
+
+void SCH_SYMBOL_LIBRARY_PANE::ShutdownCanvases()
+{
+    if( m_symbolPreview && m_symbolPreview->GetCanvas() )
+    {
+        m_symbolPreview->GetCanvas()->SetEvtHandlerEnabled( false );
+        m_symbolPreview->GetCanvas()->StopDrawing();
+    }
+
+    if( m_fpPreview && m_fpPreview->IsInitialized() && m_fpPreview->GetPreviewPanel() )
+    {
+        EDA_DRAW_PANEL_GAL* canvas = m_fpPreview->GetPreviewPanel()->GetCanvas();
+
+        if( canvas )
+        {
+            canvas->SetEvtHandlerEnabled( false );
+            canvas->StopDrawing();
+        }
+    }
+}
+
+
+void SCH_SYMBOL_LIBRARY_PANE::onOpenLibsTimer( wxTimerEvent& aEvent )
+{
+    if( EESCHEMA_SETTINGS* cfg = dynamic_cast<EESCHEMA_SETTINGS*>( Kiface().KifaceSettings() ) )
+        m_adapter->OpenLibs( cfg->m_LibTree.open_libs );
+}
+
+
+void SCH_SYMBOL_LIBRARY_PANE::showFootprintFor( const LIB_ID& aLibId )
+{
+    if( !m_fpPreview || !m_fpPreview->IsInitialized() )
+        return;
+
+    LIB_SYMBOL* symbol = nullptr;
+
+    try
+    {
+        symbol = PROJECT_SCH::SymbolLibAdapter( &m_frame->Prj() )->LoadSymbol( aLibId );
+    }
+    catch( const IO_ERROR& ioe )
+    {
+        wxLogError( _( "Error loading symbol %s from library '%s'." ) + wxS( "\n%s" ),
+                    aLibId.GetLibItemName().wx_str(),
+                    aLibId.GetLibNickname().wx_str(),
+                    ioe.What() );
+    }
+
+    if( !symbol )
+        return;
+
+    SCH_FIELD* fpField = symbol->GetField( FIELD_T::FOOTPRINT );
+    wxString   fpName = fpField ? fpField->GetFullText() : wxString( "" );
+
+    showFootprint( fpName );
+}
+
+
+void SCH_SYMBOL_LIBRARY_PANE::showFootprint( const wxString& aFootprint )
+{
+    if( !m_fpPreview || !m_fpPreview->IsInitialized() )
+        return;
+
+    if( aFootprint == wxEmptyString )
+    {
+        m_fpPreview->SetStatusText( _( "No footprint specified" ) );
+    }
+    else
+    {
+        LIB_ID libId;
+
+        if( libId.Parse( aFootprint ) == -1 && libId.IsValid() )
+        {
+            m_fpPreview->ClearStatus();
+            m_fpPreview->DisplayFootprint( libId );
+        }
+        else
+        {
+            m_fpPreview->SetStatusText( _( "Invalid footprint specified" ) );
+        }
+    }
+}
+
+
+void SCH_SYMBOL_LIBRARY_PANE::populateFootprintSelector( const LIB_ID& aLibId )
+{
+    if( !m_fpSelect )
+        return;
+
+    m_fpSelect->ClearFilters();
+
+    LIB_SYMBOL* symbol = nullptr;
+
+    if( aLibId.IsValid() )
+    {
+        try
+        {
+            symbol = PROJECT_SCH::SymbolLibAdapter( &m_frame->Prj() )->LoadSymbol( aLibId );
+        }
+        catch( const IO_ERROR& ioe )
+        {
+            wxLogError( _( "Error loading symbol %s from library '%s'." ) + wxS( "\n%s" ),
+                        aLibId.GetLibItemName().wx_str(),
+                        aLibId.GetLibNickname().wx_str(),
+                        ioe.What() );
+        }
+    }
+
+    if( symbol )
+    {
+        int pinCount = symbol->GetGraphicalPins( 0, 1 ).size();
+        SCH_FIELD* fpField = symbol->GetField( FIELD_T::FOOTPRINT );
+        wxString   fpName = fpField ? fpField->GetFullText() : wxString( "" );
+
+        m_fpSelect->FilterByPinCount( pinCount );
+        m_fpSelect->FilterByFootprintFilters( symbol->GetFPFilters(), true );
+        m_fpSelect->SetDefaultFootprint( fpName );
+        m_fpSelect->UpdateList();
+        m_fpSelect->Enable();
+    }
+    else
+    {
+        m_fpSelect->UpdateList();
+        m_fpSelect->Disable();
+    }
+}
+
+
+void SCH_SYMBOL_LIBRARY_PANE::onFootprintSelected( wxCommandEvent& aEvent )
+{
+    m_fpOverride = aEvent.GetString();
+
+    std::erase_if( m_fieldEdits, []( const std::pair<FIELD_T, wxString>& aEdit )
+                                  {
+                                      return aEdit.first == FIELD_T::FOOTPRINT;
+                                  } );
+
+    m_fieldEdits.emplace_back( FIELD_T::FOOTPRINT, m_fpOverride );
+    showFootprint( m_fpOverride );
+}
+
+
+void SCH_SYMBOL_LIBRARY_PANE::onSymbolSelected( wxCommandEvent& aEvent )
+{
+    LIB_TREE_NODE* node = m_tree->GetCurrentTreeNode();
+
+    m_fpOverride.clear();
+    m_fieldEdits.clear();
+
+    if( node && node->m_LibId.IsValid() )
+    {
+        m_symbolPreview->DisplaySymbol( node->m_LibId, node->m_Unit );
+
+        if( !node->m_Footprint.IsEmpty() )
+            showFootprint( node->m_Footprint );
+        else
+            showFootprintFor( node->m_LibId );
+
+        populateFootprintSelector( node->m_LibId );
+    }
+    else
+    {
+        m_symbolPreview->SetStatusText( _( "No symbol selected" ) );
+
+        if( m_fpPreview && m_fpPreview->IsInitialized() )
+            m_fpPreview->SetStatusText( wxEmptyString );
+
+        populateFootprintSelector( LIB_ID() );
+    }
+}
+
+
+void SCH_SYMBOL_LIBRARY_PANE::onSymbolChosen( wxCommandEvent& aEvent )
+{
+    placeSelectedSymbol();
+}
+
+
+void SCH_SYMBOL_LIBRARY_PANE::placeSelectedSymbol()
+{
+    int    unit = 0;
+    LIB_ID id = m_tree->GetSelectedLibId( &unit );
+
+    if( !id.IsValid() )
+        return;
+
+    if( unit == 0 )
+        unit = 1;
+
+    LIB_SYMBOL* libSymbol = m_frame->GetLibSymbol( id );
+
+    if( !libSymbol )
+        return;
+
+    PICKED_SYMBOL selection;
+    selection.LibId = id;
+    selection.Unit = unit;
+    selection.Convert = 1;
+    selection.Fields = m_fieldEdits;
+
+    SCH_SYMBOL* symbol = new SCH_SYMBOL( *libSymbol, &m_frame->GetCurrentSheet(), selection,
+                                         VECTOR2I( 0, 0 ), &m_frame->Schematic() );
+
+    if( m_frame->eeconfig()->m_AutoplaceFields.enable )
+        symbol->AutoplaceFields( nullptr, AUTOPLACE_AUTO );
+
+    m_frame->GetToolManager()->PostAction( SCH_ACTIONS::placeSymbol,
+                                           SCH_ACTIONS::PLACE_SYMBOL_PARAMS{ symbol, true } );
+}
