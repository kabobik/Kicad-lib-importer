+wxString LIB_TREE::getStateKey( const LIB_TREE_NODE* aNode ) const
+{
+    if( !aNode )
+        return wxEmptyString;
+
+    std::vector<wxString> parts;
+
+    for( const LIB_TREE_NODE* node = aNode;
+            node && node->m_Type != LIB_TREE_NODE::TYPE::ROOT;
+            node = node->m_Parent )
+    {
+        switch( node->m_Type )
+        {
+        case LIB_TREE_NODE::TYPE::LIBRARY:
+            parts.push_back( wxT( "L:" ) + node->m_Name );
+            break;
+
+        case LIB_TREE_NODE::TYPE::GROUP:
+        {
+            const LIB_TREE_NODE_GROUP* group = static_cast<const LIB_TREE_NODE_GROUP*>( node );
+            parts.push_back( wxT( "G:" ) + group->m_GroupColumn + wxT( "=" ) + group->m_GroupValue );
+            break;
+        }
+
+        case LIB_TREE_NODE::TYPE::ITEM:
+            parts.push_back( wxT( "I:" ) + wxString( node->m_LibId.Format().wx_str() ) );
+            break;
+
+        case LIB_TREE_NODE::TYPE::UNIT:
+            parts.push_back( wxString::Format( wxT( "U:%d" ), node->m_Unit ) );
+            break;
+
+        default:
+            parts.push_back( wxT( "N:" ) + node->m_Name );
+            break;
+        }
+    }
+
+    std::reverse( parts.begin(), parts.end() );
+
+    wxString key;
+
+    for( const wxString& part : parts )
+    {
+        key += wxString::Format( wxT( "%u:" ), static_cast<unsigned>( part.Length() ) );
+        key += part;
+    }
+
+    return key;
+}
+
+
+void LIB_TREE::collectExpandedState( const wxDataViewItem& aItem, STATE& aState ) const
+{
+    wxDataViewItemArray children;
+    m_adapter->GetChildren( aItem, children );
+
+    for( const wxDataViewItem& child : children )
+    {
+        if( !m_tree_ctrl->IsExpanded( child ) )
+            continue;
+
+        wxString key = getStateKey( m_adapter->GetTreeNodeFor( child ) );
+
+        if( !key.IsEmpty() )
+            aState.expanded.push_back( key );
+
+        collectExpandedState( child, aState );
+    }
+}
+
+
+void LIB_TREE::restoreExpandedState( const wxDataViewItem& aItem,
+                                     const std::vector<wxString>& aExpandedKeys )
+{
+    wxDataViewItemArray children;
+    m_adapter->GetChildren( aItem, children );
+
+    for( const wxDataViewItem& child : children )
+    {
+        wxString key = getStateKey( m_adapter->GetTreeNodeFor( child ) );
+
+        if( std::find( aExpandedKeys.begin(), aExpandedKeys.end(), key ) == aExpandedKeys.end() )
+            continue;
+
+        m_tree_ctrl->Expand( child );
+        restoreExpandedState( child, aExpandedKeys );
+    }
+}
