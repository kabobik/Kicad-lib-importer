+wxString LIB_TREE_MODEL_ADAPTER::getDisplayName( const LIB_TREE_NODE& aNode ) const
+{
+    wxString name = aNode.m_Name;
+
+    if( aNode.m_Type != LIB_TREE_NODE::TYPE::ITEM )
+        return UnescapeString( name );
+
+    std::vector<wxString> pathParts;
+
+    if( const LIB_TREE_NODE* lib = getLibraryNode( aNode ) )
+    {
+        wxString libName = lib->m_Name;
+        size_t   sep = libName.rfind( wxT( " - " ) );
+
+        if( sep != wxString::npos )
+            libName = libName.Mid( sep + 3 );
+
+        if( !libName.IsEmpty() && !libName.StartsWith( wxT( "-- " ) ) )
+            pathParts.push_back( libName );
+    }
+
+    std::vector<wxString> groupParts;
+
+    for( const LIB_TREE_NODE* parent = aNode.m_Parent; parent; parent = parent->m_Parent )
+    {
+        if( parent->m_Type == LIB_TREE_NODE::TYPE::GROUP )
+            groupParts.push_back( parent->m_Name );
+    }
+
+    std::reverse( groupParts.begin(), groupParts.end() );
+
+    for( const wxString& groupPart : groupParts )
+    {
+        if( !groupPart.IsEmpty()
+                && ( pathParts.empty() || pathParts.back() != groupPart ) )
+        {
+            pathParts.push_back( groupPart );
+        }
+    }
+
+    std::vector<wxString> candidates;
+
+    for( size_t start = 0; start < pathParts.size(); ++start )
+    {
+        wxString candidate;
+
+        for( size_t end = start; end < pathParts.size(); ++end )
+        {
+            if( !candidate.IsEmpty() )
+                candidate += wxT( "/" );
+
+            candidate += pathParts[end];
+
+            wxString prefix = candidate + wxT( "/" );
+
+            if( std::find( candidates.begin(), candidates.end(), prefix ) == candidates.end() )
+                candidates.push_back( prefix );
+        }
+    }
+
+    std::sort( candidates.begin(), candidates.end(),
+            []( const wxString& a, const wxString& b )
+            {
+                return a.Length() > b.Length();
+            } );
+
+    for( const wxString& prefix : candidates )
+    {
+        if( name.StartsWith( prefix ) && name.Length() > prefix.Length() )
+        {
+            name = name.Mid( prefix.Length() );
+            break;
+        }
+    }
+
+    return UnescapeString( name );
+}
