+const LIB_TREE_NODE* LIB_TREE_MODEL_ADAPTER::getLibraryNode( const LIB_TREE_NODE& aNode ) const
+{
+    const LIB_TREE_NODE* node = &aNode;
+
+    while( node && node->m_Type != LIB_TREE_NODE::TYPE::LIBRARY )
+        node = node->m_Parent;
+
+    return node;
+}
