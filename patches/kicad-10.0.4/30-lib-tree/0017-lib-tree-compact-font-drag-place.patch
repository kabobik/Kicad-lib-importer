+void LIB_TREE::onTreeBeginDrag( wxDataViewEvent& aEvent )
+{
+    hidePreview();
+
+    wxDataViewItem item = aEvent.GetItem();
+
+    if( !item.IsOk() )
+    {
+        aEvent.Veto();
+        return;
+    }
+
+    if( item != m_tree_ctrl->GetSelection() )
+    {
+        m_tree_ctrl->UnselectAll();
+        m_tree_ctrl->Select( item );
+        postPreselectEvent();
+    }
+
+    if( !GetSelectedLibId().IsValid() )
+    {
+        aEvent.Veto();
+        return;
+    }
+
+    if( !m_inTimerEvent )
+        updateRecentSearchMenu();
+
+    postSelectEvent();
+    aEvent.Veto();
+}
