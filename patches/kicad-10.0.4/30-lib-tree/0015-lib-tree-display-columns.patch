+void LIB_TREE_MODEL_ADAPTER::SetTreeDisplayColumns( const std::vector<wxString>& aColumns )
+{
+    std::vector<wxString> columns;
+
+    for( const wxString& column : aColumns )
+    {
+        if( column.IsEmpty() || column == _HKI( "Item" ) )
+            continue;
+
+        if( std::find( columns.begin(), columns.end(), column ) == columns.end() )
+            columns.push_back( column );
+    }
+
+    m_treeDisplayColumns = columns;
+
+    if( m_widget )
+        RefreshTree();
+}
