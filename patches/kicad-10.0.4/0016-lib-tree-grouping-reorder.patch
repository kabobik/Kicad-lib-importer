+
+void LIB_TREE::moveGroupingColumn( const wxString& aColumn, int aOffset )
+{
+    std::vector<wxString> columns = m_adapter->GetGroupColumns();
+    auto it = std::find( columns.begin(), columns.end(), aColumn );
+
+    if( it == columns.end() )
+        return;
+
+    int oldIndex = std::distance( columns.begin(), it );
+    int newIndex = oldIndex + aOffset;
+
+    if( newIndex < 0 || newIndex >= static_cast<int>( columns.size() ) )
+        return;
+
+    std::swap( columns[oldIndex], columns[newIndex] );
+    m_adapter->SetGroupColumns( columns );
+    updateGroupingControls();
+}
