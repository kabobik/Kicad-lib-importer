+
+
+// Force the reported ordering: the UI takes a snapshot, the worker replaces the cache,
+// then the UI reads the old search terms. No timing-dependent sleeps are needed.
+BOOST_AUTO_TEST_CASE( FootprintSnapshotSurvivesBackgroundReload )
+{
+    KI_TEST::TEMPORARY_DIRECTORY tmpLib( "kicad_qa_adapter_snapshot", ".pretty" );
+    const std::filesystem::path source =
+            std::filesystem::path( getResistorLibPath().ToStdString() ) / "R_0402_1005Metric.kicad_mod";
+    const auto oldFile = tmpLib.GetPath() / "R_0402_1005Metric.kicad_mod";
+    std::filesystem::copy_file( source, oldFile );
+
+    LIBRARY_MANAGER                manager;
+    TEST_FOOTPRINT_LIBRARY_ADAPTER adapter( manager );
+    const wxString nickname = wxS( "SnapshotReload" );
+    adapter.SeedLoadedLibrary( nickname, tmpLib.GetPath().string() );
+    adapter.RefreshLibraryIfChanged( nickname );
+
+    auto snapshot = adapter.GetFootprints( nickname, true );
+    BOOST_REQUIRE_EQUAL( snapshot.size(), 1u );
+    std::weak_ptr<FOOTPRINT> oldFootprint = snapshot.front();
+    const LIB_ID oldId = snapshot.front()->GetFPID();
+    snapshot.front()->GetSearchTerms();
+
+    // Ensure the timestamp changes by changing the number of files as well as their names.
+    std::filesystem::remove( oldFile );
+    std::filesystem::copy_file( source, tmpLib.GetPath() / "ReplacementA.kicad_mod" );
+    std::filesystem::copy_file( source, tmpLib.GetPath() / "ReplacementB.kicad_mod" );
+
+    std::exception_ptr error;
+    std::thread worker( [&]()
+    {
+        try
+        {
+            adapter.RefreshLibraryIfChanged( nickname );
+        }
+        catch( ... )
+        {
+            error = std::current_exception();
+        }
+    } );
+    worker.join();
+
+    if( error )
+        std::rethrow_exception( error );
+
+    auto current = adapter.GetFootprints( nickname, true );
+    BOOST_REQUIRE_EQUAL( current.size(), 2u );
+    BOOST_CHECK( current.front().get() != snapshot.front().get() );
+    BOOST_CHECK( !oldFootprint.expired() );
+    BOOST_CHECK( snapshot.front()->GetFPID() == oldId );
+    BOOST_CHECK( !snapshot.front()->GetSearchTerms().empty() );
+
+    snapshot.clear();
+    BOOST_CHECK( oldFootprint.expired() );
 }
 
 
