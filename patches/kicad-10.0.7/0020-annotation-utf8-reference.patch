diff --git a/qa/tests/eeschema/test_sch_reference_list.cpp b/qa/tests/eeschema/test_sch_reference_list.cpp
--- a/qa/tests/eeschema/test_sch_reference_list.cpp
+++ b/qa/tests/eeschema/test_sch_reference_list.cpp
@@ -417,4 +417,34 @@
 }
 
 
+BOOST_AUTO_TEST_CASE( SplitUtf8References )
+{
+    for( const wxString& prefix : { wxString::FromUTF8( "С" ), wxString::FromUTF8( "ДД" ),
+                                   wxString::FromUTF8( "Ω" ), wxString::FromUTF8( "電" ),
+                                   wxString::FromUTF8( "RС" ), wxString( "C" ) } )
+    {
+        SCH_REFERENCE ref;
+        wxString fullRef = prefix + "001";
+
+        // Repeated splitting and recombination must not grow the reference.
+        for( int pass = 0; pass < 10; ++pass )
+        {
+            ref.SetRef( fullRef );
+            BOOST_CHECK( ref.IsSplitNeeded() );
+            ref.Split();
+            BOOST_CHECK_EQUAL( ref.GetRef(), prefix );
+            BOOST_CHECK_EQUAL( ref.GetRefNumber(), "001" );
+            BOOST_CHECK( !ref.IsSplitNeeded() );
+            fullRef = ref.GetRef() + ref.GetRefNumber();
+            BOOST_CHECK_EQUAL( fullRef, prefix + "001" );
+        }
+
+        ref.SetRef( prefix + "?" );
+        ref.Split();
+        BOOST_CHECK_EQUAL( ref.GetRef(), prefix );
+        BOOST_CHECK_EQUAL( ref.GetRefNumber(), "?" );
+    }
+}
+
+
 BOOST_AUTO_TEST_SUITE_END()
